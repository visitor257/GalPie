          {
            "clear_all": false,
            "content": {
              "speaking": {
                "zh": "主角",
                "en": "Protagonist",
                "ja": "主人公",
                "ru": "Протагонист"
              },
              "words": {
                "zh": "啊，没有，请坐吧。",
                "en": "Oh, no, please have a seat.",
                "ja": "あ、空いてますよ。どうぞ座ってください。",
                "ru": "А, нет, садитесь, пожалуйста."
              }
            }
          }
        ],
        "4": [
          {
            "clear_all": false,
            "content": {
              "speaking": {
                "zh": "",
                "en": "",
                "ja": "",
                "ru": ""
              },
              "words": {
                "zh": "一个温暖的春日午后，阳光透过树叶洒在公园的长椅上。",
                "en": "On a warm spring afternoon, sunlight filtered through the leaves onto a park bench.",
                "ja": "暖かい春の午後、木漏れ日が公園のベンチに降り注いでいた。",
                "ru": "Тёплым весенним днём солнечные лучи пробивались сквозь листву на парковую скамейку."
              }
            }
          }
        ],
        "5": [
          {
            "clear_all": true,
            "change": "gradient",
            "bg": "公园",
            "characters": {
              "girl": {
                "form": "校服",
