            },
            "content": {
              "speaking_name": "girl",
              "words": {
                "zh": "谢谢。我经常看到你一个人坐在这里，是在想什么事情吗？",
                "en": "Thanks. I often see you sitting here alone. Are you thinking about something?",
                "ja": "ありがとう。いつも一人でここに座っているのを見かけますが、何か考えているんですか？",
                "ru": "Спасибо. Я часто вижу, как вы сидите здесь один. О чём-то задумались?"
              }
            },
            "audio": {
              "json_mode": "judge",
              "play_in_order": [["./res/audio/audio_girl_<line>_<page>_<lang_id>.wav"]]
            }
